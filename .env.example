# Copy to .env and fill in. Never commit .env.

# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./data/vestadz.db
# demo = synthetic data only. live = Meta integration (Phase 2, not implemented yet).
DATA_MODE=demo
FRONTEND_ORIGIN=http://localhost:3000
REPORTING_TIMEZONE=Asia/Kolkata

# Analysis thresholds (minimum data before an ad is ranked)
MIN_SPEND=2000
MIN_IMPRESSIONS=5000
MIN_CONVERSIONS=5

# Meta Marketing API (Phase 2). Placeholders only.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-system-user-token
META_API_VERSION=v0.0

# Frontend (used by Next.js rewrites; server-side only)
BACKEND_URL=http://127.0.0.1:8000
